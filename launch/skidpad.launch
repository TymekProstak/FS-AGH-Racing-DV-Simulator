<launch>
  <arg name="sim_time" default="-1"/>

  <include file="$(find lem_simulator)/launch/_simulator.launch">
    <arg name="param_file" value="$(find lem_simulator)/config/params_default_lem.json"/>
    <arg name="cones_file" value="$(find lem_simulator)/tracks/skidpad_cones.csv"/>
    <arg name="centerline_file" value="$(find lem_simulator)/tracks/skidpad_centerline.csv"/>
    <arg name="log_file" value="$(find lem_simulator)/logs/skidpad.csv"/>
    <arg name="sim_time" value="$(arg sim_time)"/>
    <arg name="initial_x_m" value="0.0"/>
    <arg name="initial_y_m" value="-15.0"/>
    <arg name="initial_yaw_rad" value="1.5707963267948966"/>
  </include>

  <include file="$(find dv_slam)/launch/slam.launch"/>
  <include file="$(find dv_path_planning)/launch/path_planning.launch">
    <arg name="mission" value="trackdrive"/>
  </include>
</launch>
